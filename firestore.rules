rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.email == 'sleepyheadaitr@gmail.com';
    }

    // Users profile collection for Admin Dashboard & authenticated user isolation
    match /users/{userId} {
      allow read, write: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
    }

    // User trips collection
    match /trips/{docId} {
      allow create: if (isAuthenticated() && request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow read, update, delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
    }

    // User expenses collection
    match /expenses/{docId} {
      allow create: if (isAuthenticated() && request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow read, update, delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
    }

    // User document vault collection
    match /documents/{docId} {
      allow create: if (isAuthenticated() && request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow read, update, delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
    }

    // User checklist items collection
    match /checklist_items/{docId} {
      allow create: if (isAuthenticated() && request.resource.data.user_id == request.auth.uid) || isAdmin();
      allow read, update, delete: if (isAuthenticated() && resource.data.user_id == request.auth.uid) || isAdmin();
    }

    // Fallback rule for any other collection: admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
