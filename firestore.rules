rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.get('admin', false) == true ||
        request.auth.token.email == 'sleepyheadaitr@gmail.com'
      );
    }

    // Helper: checks whether a user is currently banned (temporary or permanent)
    function isUserBanned(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
        get(/databases/$(database)/documents/users/$(userId)).data.get('banStatus', 'none') in ['permanent', 'temporary'];
    }

    // Users profile collection for Admin Dashboard & authenticated user isolation
    match /users/{userId} {
      allow read: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      allow update: if (isAuthenticated() && request.auth.uid == userId && !isUserBanned(userId)) || isAdmin();
      allow delete: if isAdmin();

      // In-app notifications subcollection: allows user to read/clear their alerts & admin to dispatch
      match /notifications/{notifId} {
        allow read, update, delete: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
        allow create: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      }
    }

    // Mail queue collection for Firebase Trigger Email extension
    match /mail/{docId} {
      allow create: if isAuthenticated() || isAdmin();
      allow read, update, delete: if isAdmin();
    }

    // Trips collection: supports collaborative shared travel lists (Feature F-1)
    match /trips/{docId} {
      allow create: if (isAuthenticated() && !isUserBanned(request.auth.uid)) || isAdmin();
      allow read: if isAuthenticated() || isAdmin();
      allow update: if (isAuthenticated() && !isUserBanned(request.auth.uid)) || isAdmin();
      allow delete: if (isAuthenticated() && (resource == null || resource.data.get('user_id', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid) && !isUserBanned(request.auth.uid)) || isAdmin();
    }

    // Expenses collection: supports collaborative shared trip expense tracking
    match /expenses/{docId} {
      allow create: if (isAuthenticated() && !isUserBanned(request.auth.uid)) || isAdmin();
      allow read: if isAuthenticated() || isAdmin();
      allow update, delete: if (isAuthenticated() && !isUserBanned(request.auth.uid)) || isAdmin();
    }

    // User document vault collection: private documents strictly protected per user
    match /documents/{docId} {
      allow create: if (isAuthenticated() && (request.resource.data.get('user_id', '') == request.auth.uid || request.resource.data.get('userId', '') == request.auth.uid) && !isUserBanned(request.auth.uid)) || isAdmin();
      allow read: if (isAuthenticated() && (resource.data.get('user_id', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid)) || isAdmin();
      allow update, delete: if (isAuthenticated() && (resource == null || resource.data.get('user_id', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid) && !isUserBanned(request.auth.uid)) || isAdmin();

      // Large document chunks subcollection (up to 10MB)
      match /chunks/{chunkId} {
        allow read, write: if isAuthenticated() || isAdmin();
      }

      match /{subcollection=**} {
        allow read, write: if isAuthenticated() || isAdmin();
      }
    }

    // Checklist items collection: supports collaborative shared packing lists
    match /checklist_items/{docId} {
      allow create: if (isAuthenticated() && !isUserBanned(request.auth.uid)) || isAdmin();
      allow read: if isAuthenticated() || isAdmin();
      allow update, delete: if (isAuthenticated() && !isUserBanned(request.auth.uid)) || isAdmin();
    }

    // World Travel Map marked countries collection: multi-device synchronization & backup
    match /travel_map/{docId} {
      allow create: if (isAuthenticated() && (request.resource.data.get('user_id', '') == request.auth.uid || request.resource.data.get('userId', '') == request.auth.uid) && !isUserBanned(request.auth.uid)) || isAdmin();
      allow read: if (isAuthenticated() && (resource.data.get('user_id', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid)) || isAdmin();
      allow update, delete: if (isAuthenticated() && (resource == null || resource.data.get('user_id', '') == request.auth.uid || resource.data.get('userId', '') == request.auth.uid) && !isUserBanned(request.auth.uid)) || isAdmin();
    }

    // Fallback rule for any other collection: admin only
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
