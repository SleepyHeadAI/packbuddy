<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Network permissions for Firebase Sync and Currency Exchange Rates -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Google Play Billing Permission -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Camera permission for Document Vault and Receipt Scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Biometric Authentication for Vault -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Storage permissions for older Android versions (SDK <= 32) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- F2: No broad media access on Android 13+. image_picker / file_picker use the system
         Photo Picker, which needs no permission. "remove" also strips any copy merged in by plugins. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" tools:node="remove" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" tools:node="remove" />

    <!-- Smart Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="PackBuddy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- PostHog EU Cloud Configuration
             F3: AUTO_INIT is disabled so nothing is captured before the user's analytics consent.
             TelemetryService.init() sets PostHog up programmatically: opted-out by default,
             session replay and touch capture off. -->
        <meta-data
            android:name="com.posthog.posthog.AUTO_INIT"
            android:value="false" />
        <meta-data
            android:name="com.posthog.posthog.API_KEY"
            android:value="phc_zJWTksx4JFN95rKAsfPxR9fUeQLFyM9ArCb9ZUkVjLeK" />
        <meta-data
            android:name="com.posthog.posthog.POSTHOG_HOST"
            android:value="https://eu.i.posthog.com" />
        <meta-data
            android:name="com.posthog.posthog.CAPTURE_APPLICATION_LIFECYCLE_EVENTS"
            android:value="true" />

        <!-- Firebase Cloud Messaging Default Channel, Icon & Color -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="packbuddy_urgent_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/notification_accent" />

        <!-- Scheduled Local Notification Receivers for Device Reboot and Exact Timing -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Home Screen App Widget - Trip Countdown (Default) -->
        <!-- #17: home-widget button actions (quick expense, toggles). NOT exported: only PackBuddy's own
             PendingIntents can reach it, so other apps cannot inject fake expenses. -->
        <receiver
            android:name=".PackBuddyWidgetActionReceiver"
            android:exported="false" />

        <receiver
            android:name=".PackBuddyWidgetProvider"
            android:label="@string/widget_label_trip"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_trip_small_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyMediumWidgetProvider"
            android:label="@string/widget_label_trip_medium"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_trip_medium_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyLargeWidgetProvider"
            android:label="@string/widget_label_trip_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_trip_large_info" />
        </receiver>

        <!-- Home Screen App Widget - World Travel Map -->
        <receiver
            android:name=".PackBuddyMapWidgetProvider"
            android:label="@string/widget_label_map"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_map_small_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyMapMediumWidgetProvider"
            android:label="@string/widget_label_map_medium"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_map_medium_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyMapLargeWidgetProvider"
            android:label="@string/widget_label_map_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_map_large_info" />
        </receiver>

        <!-- Home Screen App Widget - Quick Expense -->
        <receiver
            android:name=".PackBuddyExpenseWidgetProvider"
            android:label="@string/widget_label_expense"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_expense_small_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyExpenseMediumWidgetProvider"
            android:label="@string/widget_label_expense_medium"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_expense_medium_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyExpenseLargeWidgetProvider"
            android:label="@string/widget_label_expense_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_expense_large_info" />
        </receiver>

        <!-- Home Screen App Widget - Currency Converter -->
        <receiver
            android:name=".PackBuddyCurrencyWidgetProvider"
            android:label="@string/widget_label_currency"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_currency_small_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyCurrencyMediumWidgetProvider"
            android:label="@string/widget_label_currency_medium"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_currency_medium_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyCurrencyLargeWidgetProvider"
            android:label="@string/widget_label_currency_large"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_currency_large_info" />
        </receiver>
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="packbuddy" />
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>
</manifest>