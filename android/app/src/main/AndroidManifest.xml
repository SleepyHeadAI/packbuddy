<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Network permissions for Firebase Sync and Currency Exchange Rates -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Google Play Billing Permission -->
    <uses-permission android:name="com.android.vending.BILLING" />

    <!-- Camera permission for Document Vault and Receipt Scanning -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Biometric Authentication for Vault -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Storage permissions for older Android versions (SDK <= 32) -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Granular media permissions for Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VIDEO" />

    <!-- Smart Notifications & Exact Alarm Scheduling -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <application
        android:label="packbuddy"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false">

        <!-- PostHog EU Cloud Configuration -->
        <meta-data
            android:name="com.posthog.posthog.API_KEY"
            android:value="phc_zJWTksx4JFN95rKAsfPxR9fUeQLFyM9ArCb9ZUkVjLeK" />
        <meta-data
            android:name="com.posthog.posthog.POSTHOG_HOST"
            android:value="https://eu.i.posthog.com" />
        <meta-data
            android:name="com.posthog.posthog.CAPTURE_APPLICATION_LIFECYCLE_EVENTS"
            android:value="true" />

        <!-- Firebase Cloud Messaging Default Channel & Icon -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="packbuddy_urgent_alerts" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@mipmap/ic_launcher" />

        <!-- Scheduled Local Notification Receivers for Device Reboot and Exact Timing -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
        <!-- Home Screen App Widget - Trip Countdown (Default) -->
        <receiver
            android:name=".PackBuddyWidgetProvider"
            android:label="PackBuddy: Seyahat"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_TRIP_VIEW" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_MAP_VIEW" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_EXPENSE_VIEW" />
                <action android:name="com.sleepyhead.packbuddy.action.QUICK_EXPENSE_INCREMENT" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_CURRENCY" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_USD_AMOUNT" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_EUR_AMOUNT" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_CONVERSIONS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_trip_small_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyMediumWidgetProvider"
            android:label="PackBuddy: Seyahat (Orta)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_TRIP_VIEW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_trip_medium_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyLargeWidgetProvider"
            android:label="PackBuddy: Seyahat (Geniş)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_TRIP_VIEW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_trip_large_info" />
        </receiver>

        <!-- Home Screen App Widget - World Travel Map -->
        <receiver
            android:name=".PackBuddyMapWidgetProvider"
            android:label="PackBuddy: Dünya Haritası"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_MAP_VIEW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_map_small_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyMapMediumWidgetProvider"
            android:label="PackBuddy: Dünya Haritası (Orta)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_MAP_VIEW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_map_medium_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyMapLargeWidgetProvider"
            android:label="PackBuddy: Dünya Haritası (Geniş)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_MAP_VIEW" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_map_large_info" />
        </receiver>

        <!-- Home Screen App Widget - Quick Expense -->
        <receiver
            android:name=".PackBuddyExpenseWidgetProvider"
            android:label="PackBuddy: Hızlı Harcama"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_EXPENSE_VIEW" />
                <action android:name="com.sleepyhead.packbuddy.action.QUICK_EXPENSE_INCREMENT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_expense_small_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyExpenseMediumWidgetProvider"
            android:label="PackBuddy: Hızlı Harcama (Orta)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_EXPENSE_VIEW" />
                <action android:name="com.sleepyhead.packbuddy.action.QUICK_EXPENSE_INCREMENT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_expense_medium_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyExpenseLargeWidgetProvider"
            android:label="PackBuddy: Hızlı Harcama (Geniş)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.TOGGLE_EXPENSE_VIEW" />
                <action android:name="com.sleepyhead.packbuddy.action.QUICK_EXPENSE_INCREMENT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_expense_large_info" />
        </receiver>

        <!-- Home Screen App Widget - Currency Converter -->
        <receiver
            android:name=".PackBuddyCurrencyWidgetProvider"
            android:label="PackBuddy: Döviz Kurları"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_CURRENCY" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_USD_AMOUNT" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_EUR_AMOUNT" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_CONVERSIONS" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/packbuddy_currency_small_info" />
        </receiver>

        <receiver
            android:name=".PackBuddyCurrencyMediumWidgetProvider"
            android:label="PackBuddy: Döviz Kurları (Orta)"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_CURRENCY" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_USD_AMOUNT" />
                <action android:name="com.sleepyhead.packbuddy.action.CYCLE_EUR_AMOUNT" />
