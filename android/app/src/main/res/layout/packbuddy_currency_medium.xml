<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- 1:1 High-Resolution Flutter Rendered Card -->
    <ImageView
        android:id="@+id/widget_rendered_card"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:adjustViewBounds="true"
        android:visibility="gone" />

    <!-- Native XML Fallback Layout -->
    <LinearLayout
        android:id="@+id/widget_native_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_bg"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Left Column: Currency Rates -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_app_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="PackBuddy • Kur"
                android:textColor="#3B82F6"
                android:textSize="10.5sp"
                android:textStyle="bold" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <!-- Rates Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/widget_usd_box"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/widget_stat_bg"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/widget_usd_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 USD"
                        android:textColor="#94A3B8"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/widget_usd_val"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="₺34.25"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/widget_eur_box"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/widget_stat_bg"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:id="@+id/widget_eur_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1 EUR"
                        android:textColor="#94A3B8"
                        android:textSize="9sp" />

                    <TextView
                        android:id="@+id/widget_eur_val"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="₺37.10"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="4dp" />

            <!-- Bottom status & Reverse rate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_live_status"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="● Canlı Kurlar"
                    android:textColor="#10B981"
                    android:textSize="9sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_reverse_rate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text=""
                    android:textColor="#94A3B8"
                    android:textSize="9sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: Currency Badge Card -->
        <LinearLayout
            android:id="@+id/widget_action_btn"
            android:layout_width="85dp"
            android:layout_height="match_parent"
            android:layout_marginStart="10dp"
            android:background="@drawable/widget_stat_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/widget_currency_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/widget_circle_badge"
                android:gravity="center"
                android:text="⇄"
                android:textColor="#3B82F6"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:gravity="center"
                android:maxLines="1"
                android:text="TRY"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>