<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Header: App Name & Currency Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_app_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="PackBuddy • Kur"
            android:textColor="#3B82F6"
            android:textSize="11.5sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/widget_badge_bg"
            android:paddingStart="8dp"
            android:paddingTop="3dp"
            android:paddingEnd="8dp"
            android:paddingBottom="3dp"
            android:text="TRY"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Hero Rates Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <!-- 1 USD Card -->
        <LinearLayout
            android:id="@+id/widget_usd_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/widget_usd_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1 USD"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_usd_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="₺34.25"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 1 EUR Card -->
        <LinearLayout
            android:id="@+id/widget_eur_box"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/widget_stat_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/widget_eur_label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="1 EUR"
                android:textColor="#94A3B8"
                android:textSize="10.5sp" />

            <TextView
                android:id="@+id/widget_eur_val"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="₺37.10"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Quick Conversions Box -->
    <LinearLayout
        android:id="@+id/widget_conversions_box"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/widget_stat_bg"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/widget_conversions_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hızlı Çevrimler"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/widget_conv_1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="$10 ≈ ₺343"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_conv_2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="$50 ≈ ₺1713"
                android:textColor="#94A3B8"
                android:textSize="9.5sp" />

            <TextView
                android:id="@+id/widget_conv_3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:gravity="end"
                android:maxLines="1"
                android:text="$100 ≈ ₺3425"
                android:textColor="#3B82F6"
                android:textSize="9.5sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Bottom Footer: Live & Sync Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_sync_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="✓ Otomatik Çift Yönlü Senkron"
            android:textColor="#94A3B8"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_offline_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Çevrim Çevrimdışı Hazır"
            android:textColor="#10B981"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>

