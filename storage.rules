rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.get('admin', false) == true ||
        request.auth.token.email == 'sleepyheadaitr@gmail.com') &&
        request.auth.token.email_verified == true
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // #6: the app only ever uploads AES-encrypted blobs as
    //   users/{uid}/vault/{documentId}.bin   (contentType application/octet-stream)
    // where documentId is a UUID. 10 MB plaintext limit + AES-GCM envelope overhead
    // (6-byte header + 12-byte nonce + 16-byte tag), with a small margin.
    function isValidVaultUpload(docId) {
      return docId.matches('^[A-Za-z0-9_-]{1,64}[.]bin$') &&
        request.resource.contentType == 'application/octet-stream' &&
        request.resource.size > 0 &&
        request.resource.size <= 10 * 1024 * 1024 + 64;
    }

    // AES-256 encrypted vault documents: readable by the owner and a verified admin (inspection).
    // Only the owner can create/replace (validated format); admins may additionally delete during purge.
    match /users/{userId}/vault/{docId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId) && isValidVaultUpload(docId);
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Nested paths are never written by the app; legacy objects stay readable/deletable.
    match /users/{userId}/vault/{docId}/{allPaths=**} {
      allow read: if isOwner(userId) || isAdmin();
      allow delete: if isOwner(userId) || isAdmin();
    }

    // Default deny for all other paths unless verified Super Admin.
    // Vault paths (users/{uid}/vault/**) are excluded here: their access is defined explicitly above
    // (admin may read/delete but never write vault blobs).
    match /{allPaths=**} {
      allow read, write: if isAdmin() && (allPaths[0] != 'users' || allPaths[2] != 'vault');
    }
  }
}
